{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/demyanovvvv/universal-prompt-optimizer/prompt-optimizer.schema.json",
  "title": "Universal Prompt Optimizer configuration",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Managed configuration schema version."
    },
    "behavior": {
      "enum": ["auto", "preview", "off"]
    },
    "scope": {
      "enum": ["first", "all"]
    },
    "qualityGate": {
      "oneOf": [
        {
          "type": "boolean",
          "deprecated": true,
          "description": "Legacy setting. true maps to adaptive; false maps to pass."
        },
        {
          "enum": ["pass", "light", "full", "adaptive"]
        }
      ]
    },
    "unsupportedModel": {
      "enum": ["skip", "generic"]
    },
    "mode": {
      "enum": ["first", "all", "off"],
      "deprecated": true,
      "description": "Legacy v4 OpenCode setting. Use behavior and scope."
    }
  },
  "additionalProperties": true
}
