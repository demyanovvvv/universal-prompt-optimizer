# Runtime state is local to an agent session and must not be committed.
.cursor/.prompt-optimizer-runtime.json
.cursor/.prompt-optimizer-session-state.json
.cursor/*.prompt-optimizer-session-state.json.lock
.cursor/*.prompt-optimizer-runtime.json.lock
.gemini/.prompt-optimizer-model-state.json
.gemini/.prompt-optimizer-session-state.json
.gemini/*.prompt-optimizer-*.json.lock

# Local Python/Node tooling artifacts.
__pycache__/
*.py[cod]
node_modules/
npm-debug.log*
