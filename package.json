{
  "name": "universal-prompt-optimizer",
  "private": true,
  "version": "5.5.0",
  "description": "Model-aware adaptive prompt preflight for coding agents",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "bash ./verify.sh",
    "verify:ts": "tsc -p tsconfig.verify.json",
    "test:runtime": "tsc -p tsconfig.test.json && node --test .tmp-tests/opencode/tests/opencode-runtime.test.js .tmp-tests/opencode/tests/eval-contract.test.js",
    "test:registry": "python -B tests/registry_conformance.py",
    "test:evals": "python -B evals/run.py",
    "test:evals:strict": "python -B evals/run.py --strict-coverage",
    "compare:evals": "python -B -m evals.compare",
    "test": "python -B -m unittest discover -s tests -v && npm run test:evals:strict && npm run test:runtime"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
